__pycache__/
*.pyc
.venv/

# Raw frisky span dumps and Chrome traces. Tens of MB each, regenerable by
# re-running with --span-dump-limit. The aggregates that the findings rest on
# live in summary.json and the frisky-*.txt reports, which are committed.
spans.json
trace.json

# Full-tile outputs: 683 MB of part files and a 4.3 GB merged raster.
# Regenerable; the logs and summaries beside them are committed.
fulltile/part*/part-000.npz
fulltile/tile/*.npy

# The two 512 KB rasters compare_qa_masks.py writes. Regenerable from the
# scene list and the window recorded in qa-parity/qa_parity.json, which is
# committed along with the difference image.
qa-parity/*.npy

# The COGs and STAC catalog that `--merge` writes. Regenerable from the part
# files, and a full-tile lst_p95.tif runs to hundreds of MB.
*/catalog/

# Vale packages fetched by `vale sync`; .vale.ini pins each release.
styles/Google/
styles/Microsoft/
styles/Readability/
styles/ai-tells/
# `vale sync` also unpacks the ai-tells agent template here.
styles/config/templates/

# Claude Code worktrees and local session state.
.claude/

# The scene inventory is 167 MB and rebuilds in 58 s from the USGS bulk file
# and a cached download. `artifacts/inventory_manifest.json` records the
# version it was built from, which is what a run needs to quote.
artifacts/tile_scene_inventory.parquet
artifacts/fleet_plan.json

# The ASTER GED observation counts: 36,000 x 12,000 uint8 on the 0.01 degree
# grid, rebuilt from cached granules. `artifacts/aster_numobs_manifest.json`
# records the granules and the digest, which is what a run needs to quote.
artifacts/aster_numobs.tif

# The buffered land geometry is 16 MB and rebuilds from Natural Earth in a few
# minutes. Three committed files stand in for it: `land_tiles.parquet` records
# its `land_geometry_sha256`, `artifacts/land_buffered_sha256.txt` carries the
# same digest so CI can check the tie without the file, and
# `artifacts/land_buffered_slice.gpkg` is the cut the tests rasterise.
artifacts/land_buffered.gpkg

# Synthetic rasters `measure_shard_memory.py --mode memory` writes. About 1 GB
# for the committed sweeps, and regenerated by the tool. The sweeps themselves
# are committed under artifacts/.
shard-memory-work/
