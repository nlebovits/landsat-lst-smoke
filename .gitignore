__pycache__/
*.pyc
.venv/

# Raw frisky span dumps and Chrome traces. Tens of MB each, regenerable by
# re-running with --span-dump-limit. The aggregates that the findings rest on
# live in summary.json and the frisky-*.txt reports, which are committed.
spans.json
trace.json

# The full-tile run's heavy outputs. `evidence/fulltile/` keeps the metadata
# that the findings rest on: part-meta.json, slice.log, summary.json, and
# merge.json are tracked and total 252 KB. The rasters they describe run to
# 5.9 GB and regenerate from a run, so they stay out.
#
# The `.tif` rule is newer than the rest. Those two files sat in a stray
# `fulltile/` at the repository root until 2026-09-17, one directory above the
# rules meant to cover them, which is also why `FINDINGS.md` documented a
# `--raster evidence/fulltile/tile/lst_p95_dn.npy` path that resolved to
# nothing. They are in place now.
evidence/fulltile/part*/part-000.npz
evidence/fulltile/tile/*.npy
evidence/fulltile/tile/*.tif
evidence/qa-parity/*.npy

# What a composite run writes. The staging GeoTIFFs are the workers' window
# targets and are removed on success; the COGs and the STAC catalog are
# regenerable and a full-tile lst_p95.tif runs to hundreds of MB. `**/`
# because a pattern holding a slash anchors here, and `*` stops at one.
composite-run/
**/catalog/
# The published catalog is the one exception. `catalog/` at the repository
# root is tracked, and it is the source of truth for every metadata object in
# the bucket. The negation names the directory itself, so git resumes walking
# into it. The COGs it describes stay in object storage.
!/catalog/
/catalog/**/*.tif
*.staging.tif
*.staging.tif.lock
**/rehearsal-scenes/
events.json
overview.json
prefixes.json
stragglers.json
metrics.json
timeline-component.txt

# Vale packages fetched by `vale sync`; .vale.ini pins each release.
styles/Google/
styles/Microsoft/
styles/Readability/
styles/ai-tells/
# `vale sync` also unpacks the ai-tells agent template here.
styles/config/templates/

# Claude Code worktrees and local session state.
.claude/

# The scene inventory is 167 MB and rebuilds in 58 s from the USGS bulk file
# and a cached download. `artifacts/inventory_manifest.json` records the
# version it was built from, which is what a run needs to quote.
artifacts/tile_scene_inventory.parquet
artifacts/fleet_plan.json

# The coverage screen, one line per land tile. Rebuilt by the same command in
# a few minutes from the three artifacts above and below, and it describes the
# inventory window it was built under rather than the code.
artifacts/fleet_plan.jsonl

# The ASTER GED observation counts: 36,000 x 12,000 uint8 on the 0.01 degree
# grid, rebuilt from cached granules. `artifacts/aster_numobs_manifest.json`
# records the granules and the digest, which is what a run needs to quote.
artifacts/aster_numobs.tif

# The buffered land geometry is 16 MB and rebuilds from Natural Earth in a few
# minutes. Three committed files stand in for it: `land_tiles.parquet` records
# its `land_geometry_sha256`, `artifacts/land_buffered_sha256.txt` carries the
# same digest so CI can check the tie without the file, and
# `artifacts/land_buffered_slice.gpkg` is the cut the tests rasterise.
artifacts/land_buffered.gpkg

# The unbuffered geometry, which is what a published `lst:land_pixels` counts.
# 7.3 MB, and it stands in the same relation to its own digest and slice:
# `artifacts/land_strict_sha256.txt` and `artifacts/land_strict_slice.gpkg` are
# committed and this file is not.
artifacts/land_strict.gpkg
